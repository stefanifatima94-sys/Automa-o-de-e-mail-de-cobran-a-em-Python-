# Copie este arquivo para ".env" e preencha com seus dados.
# NUNCA compartilhe o arquivo .env (ele contém sua senha).

# Gmail: smtp.gmail.com / 587  (use uma "Senha de app", não sua senha normal)
# Outlook/Hotmail: smtp-mail.outlook.com / 587
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=seu_email@gmail.com
SMTP_SENHA=sua_senha_de_app

REMETENTE_NOME=Financeiro - Minha Empresa
REMETENTE_EMAIL=seu_email@gmail.com

EMPRESA=Minha Empresa Ltda
CHAVE_PIX=financeiro@minhaempresa.com.br
TELEFONE=(11) 99999-9999

# Quantos dias antes do vencimento enviar o lembrete
DIAS_LEMBRETE=3
