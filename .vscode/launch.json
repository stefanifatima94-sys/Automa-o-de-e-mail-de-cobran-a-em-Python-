{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cobrança: simular (não envia)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Cobrança: ENVIAR e-mails",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--enviar"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
